#include <iostream>
#include <iomanip>
#include <cmath>
using namespace std;

int main() {
    // Прототип допоміжної функції всередині main()
    double f(const double x);

    double tp, tk, t, dt, y;
    int n;

    cout << "tp = "; cin >> tp;
    cout << "tk = "; cin >> tk;
    cout << "n  = "; cin >> n;

    dt = (tk - tp) / n;

    cout << fixed;
    cout << "----------------------------------" << endl;
    cout << "|" << setw(10) << "t" << " |"
        << setw(17) << "y" << " |" << endl;
    cout << "----------------------------------" << endl;

    t = tp;
    while (t <= tk) {
        y = f(2 * t) + pow(f(t * t + 1), 2);
        cout << "|" << setw(10) << setprecision(2) << t << " |"
            << setw(17) << setprecision(5) << y << " |" << endl;
        t += dt;
    }
    cout << "----------------------------------" << endl;

    return 0;
}

// Реалізація допоміжної функції під return 0;
double f(const double x) {
    if (abs(x) >= 1) {
        return (sin(2 * x) + 1.0) / (sin(x) + pow(cos(x), 2));
    }
    else {
        double S = 0;
        int n = 0;
        double a = x * x; // Перший доданок (n = 0)
        S = a;
        do {
            n++;
            double R = pow(x, 4) / ((2.0 * n) * (2.0 * n + 1.0));
            a *= R;
            S += a;
        } while (n < 7);
        return S;
    }
}
